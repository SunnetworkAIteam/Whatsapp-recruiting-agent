# This file lists all environment variables the project needs.
# Copy this to a file named ".env" (no "example") and fill in real values there.
# Never commit your real .env file — only this template (with blank values) should be in git.
# See CONTRIBUTING.md for what you actually need to run/test locally.

# Database
DATABASE_URL=postgresql://postgres:localdev@localhost:5432/whatsapp_pipeline

# Redis / Celery broker
REDIS_URL=redis://localhost:6379/0

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# LLM 
ANTHROPIC_API_KEY=

# App
ESCALATION_CONFIDENCE_THRESHOLD=0.75
